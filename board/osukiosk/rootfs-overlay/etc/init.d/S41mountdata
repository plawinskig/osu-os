#!/bin/sh
# Mounts the persistent F2FS data partition (beatmaps, settings,
# scores) into the running-from-tmpfs main system. Runs once during
# sysinit, before the session launcher's first respawn cycle, and
# unmounts the partition again on shutdown (rcK calls "stop").

DATA_LABEL=OSUKIOSK_DATA

# The mount point exists in the rootfs overlay (data/.empty): the root
# is a read-only squashfs, so it cannot be created at runtime.
MOUNT_POINT=/data

# Find the partition by filesystem LABEL, not by device path - the same
# reasoning as in the initramfs /init: device enumeration order (sda vs
# sdb, or NVMe naming) is not guaranteed to be identical across host
# machines, which breaks the "boot on any hardware" requirement if we
# hardcode a path like /dev/sda2. BusyBox mount is built without label
# support (no "mount -L"), so ask blkid instead; it prints lines like
#   /dev/sda2: LABEL="OSUKIOSK_DATA" UUID="..." TYPE="f2fs"
find_data_device() {
    blkid | sed -n "s|^\([^:]*\):.*LABEL=\"$DATA_LABEL\".*|\1|p" | head -n 1
}

warn() {
    echo "WARNING: $*, continuing without persistence" > /dev/kmsg
}

# A missing or unmountable data partition (corrupted filesystem,
# unexpected media) deliberately does NOT panic or halt boot. A kiosk
# that refuses to start because scores can't be saved is a worse
# failure mode than one that starts read-only-effectively and simply
# can't persist this session's results.
start() {
    device=$(find_data_device)
    if [ -z "$device" ]; then
        warn "no partition labelled $DATA_LABEL found"
        return 1
    fi

    if ! mount -t f2fs "$device" "$MOUNT_POINT"; then
        warn "failed to mount $device on $MOUNT_POINT"
        return 1
    fi

    # F2FS carries real per-inode uid/gid/mode, unlike FAT, and whatever
    # the partition's root directory happened to be formatted with (e.g.
    # the host user who last ran mkfs.f2fs) has no relation to the target
    # "kiosk" account. Fix ownership here, on every boot, so persistence
    # does not depend on how data.img was created. Non-recursive: only the
    # mount point itself can be wrong this way, since anything kiosk later
    # creates under it already gets kiosk's uid/gid from the kernel, and
    # walking the whole beatmap/scores tree on every boot would not be
    # free once it grows.
    if ! chown kiosk:kiosk "$MOUNT_POINT" || ! chmod 0700 "$MOUNT_POINT"; then
        warn "failed to set ownership/permissions on $MOUNT_POINT"
    fi
}

stop() {
    umount "$MOUNT_POINT"
}

case "$1" in
    start|stop)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
