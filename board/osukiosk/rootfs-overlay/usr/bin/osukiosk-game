#!/bin/sh
# The program the kiosk shows full screen: cage's only client, started by
# /usr/bin/osukiosk-session as the unprivileged "kiosk" account with HOME
# on the data partition. cage exits when this program exits and passes
# its exit status on; in the demo version the session then starts the
# game again whether the player left it or it crashed.
#
# It starts osu!lazer from /opt/osu-lazer (the official release, with its
# own .NET runtime; see package/osu-lazer). The game keeps its data under
# $HOME/.local/share/osu, so beatmaps, scores and settings live on the
# data partition, and so do the shader caches in $HOME/.cache.

# The image is read-only and offline, so the game's built-in updater
# (Velopack) must stay off. Distribution packages turn it off the same
# way: any value here tells osu! that updates come from elsewhere.
export OSU_EXTERNAL_UPDATE_PROVIDER=osukiosk

# The image has no X11, only cage's Wayland display.
export SDL_VIDEO_DRIVER=wayland

# Without a network, beatmaps arrive as .osz files copied from another
# computer into the import directory on the data partition (its path
# comes from osukiosk-session, because without /data it is on tmpfs).
# osu! imports the archives given on its command line and deletes each
# one after a successful import, so a file that is still there on the
# next start failed and is simply tried again.
set --
for archive in "$OSUKIOSK_IMPORT_DIR"/*.osz "$OSUKIOSK_IMPORT_DIR"/*.olz; do
	[ -f "$archive" ] && set -- "$@" "$archive"
done

# exec: the game itself becomes cage's client, so the status cage passes
# on to osukiosk-session is the game's own.
exec /opt/osu-lazer/osu! "$@"
