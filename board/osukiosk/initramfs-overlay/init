#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

# Retry budget for the boot device search: USB enumeration speed varies
# across hardware, so this needs enough margin for slower machines. Tune by
# changing these two values only.
RETRY_COUNT=15
RETRY_SLEEP=2

echo "Looking for the boot device (up to $((RETRY_COUNT * RETRY_SLEEP))s)..."
mkdir -p /mnt/boot
FOUND=0

i=0
while [ "$i" -lt "$RETRY_COUNT" ]; do
    for dev in /dev/sd* /dev/nvme*n1p*; do
        if [ -b "$dev" ]; then
            # -t vfat: the boot partition is always FAT32 by design, and
            # BusyBox mount's type autodetection would otherwise probe F2FS
            # first (matching the data partition's filesystem), logging a
            # harmless but noisy "Magic Mismatch" on every candidate device.
            mount -t vfat "$dev" /mnt/boot 2>/dev/null
            if [ -f /mnt/boot/rootfs.squashfs ]; then
                FOUND=1
                break 2
            fi
            umount /mnt/boot 2>/dev/null
        fi
    done
    i=$((i + 1))
    sleep "$RETRY_SLEEP"
done

if [ "$FOUND" -eq 0 ]; then
    echo "FATAL ERROR: rootfs.squashfs not found on any boot device"
    echo "--- /proc/partitions ---"
    cat /proc/partitions
    echo "--- dmesg (tail) ---"
    dmesg | tail -n 40
    exec sh
fi

# Prints /proc/uptime in hundredths of a second. The file has exactly two
# decimals ("12.34 ..."); ash arithmetic is integer-only, and the "1"
# put in front of the decimals keeps a value like "08" from being read as
# an invalid octal number.
uptime_centiseconds() {
    read -r up _ < /proc/uptime
    echo $(( ${up%.*} * 100 + 1${up#*.} - 100 ))
}

echo "Copying the system image to RAM..."
copy_start=$(uptime_centiseconds)
cp /mnt/boot/rootfs.squashfs /tmp/ || exec sh
copy_time=$(( $(uptime_centiseconds) - copy_start ))

# The size of the system image costs boot time on every machine, so the
# copy is measured where it happens: the line goes to the kernel log, and
# the session saves the kernel log to /data/log/dmesg.txt at every boot.
[ "$copy_time" -gt 0 ] || copy_time=1
image_size=$(wc -c < /tmp/rootfs.squashfs)
speed_tenths=$(( image_size * 1000 / 1048576 / copy_time ))
printf 'osukiosk-initramfs: copied rootfs.squashfs to RAM, %d MiB in %d.%02d s (%d.%d MiB/s)\n' \
    $(( image_size / 1048576 )) $(( copy_time / 100 )) $(( copy_time % 100 )) \
    $(( speed_tenths / 10 )) $(( speed_tenths % 10 )) > /dev/kmsg

mkdir -p /mnt/root
mount -t squashfs -o loop /tmp/rootfs.squashfs /mnt/root || exec sh
umount /mnt/boot

exec switch_root /mnt/root /sbin/init || exec sh
