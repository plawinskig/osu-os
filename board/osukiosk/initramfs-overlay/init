#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

echo "Szukanie pendrive'a z systemem (max 10s)..."
mkdir -p /mnt/boot
FOUND=0

for i in 1 2 3 4 5; do
    for dev in /dev/sd* /dev/nvme*n1p*; do
        if [ -b "$dev" ]; then
            mount "$dev" /mnt/boot 2>/dev/null
            if [ -f /mnt/boot/rootfs.squashfs ]; then
                FOUND=1
                break 2
            fi
            umount /mnt/boot 2>/dev/null
        fi
    done
    sleep 2
done

if [ $FOUND -eq 0 ]; then
    echo "FATAL ERROR: Nie znaleziono rootfs.squashfs!"
    exec sh
fi

echo "Kopiowanie systemu do RAM..."
cp /mnt/boot/rootfs.squashfs /tmp/ || exec sh

mkdir -p /mnt/root
mount -t squashfs -o loop /tmp/rootfs.squashfs /mnt/root || exec sh
umount /mnt/boot

exec switch_root /mnt/root /sbin/init || exec sh
